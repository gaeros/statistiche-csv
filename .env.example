# Copia questo file in .env.local e inserisci i valori del progetto Supabase di sviluppo.
# .env.local è ignorato da git: le chiavi non finiscono mai nel repository.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...) oppure la vecchia "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...) oppure la vecchia "service_role"
# SOLO lato server: non deve mai iniziare con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limiti (uguali alla produzione)
LIMITE_FILE_MB=50
QUOTA_UTENTE_MB=100
